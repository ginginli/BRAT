{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/bratgreen",
      "destination": "/bratgreen/",
      "permanent": true
    },
    {
      "source": "http://bratgenerator.com.cn/(.*)",
      "destination": "https://www.bratgenerator.com.cn/$1",
      "permanent": true
    },
    {
      "source": "https://bratgenerator.com.cn/(.*)",
      "destination": "https://www.bratgenerator.com.cn/$1",
      "permanent": true
    },
    {
      "source": "http://www.bratgenerator.com.cn/(.*)",
      "destination": "https://www.bratgenerator.com.cn/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800"
        }
      ]
    },
    {
      "source": "/locales/:lang/translations.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}